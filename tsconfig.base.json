{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@mrincer/source"],
    "paths": {
      "@edunic/source/db": ["libs/db/src/index.ts"],
      "@edunic/source/db/schema": ["libs/db/src/schema/index.ts"],
      "@edunic/source/domain/events": ["libs/domain/src/events.ts"],
      "@edunic/source/domain/shared": ["libs/domain/src/shared/index.ts"],
      "@edunic/source/domain/audit-logs": ["libs/domain/src/audit-logs/index.ts"],
      "@edunic/source/domain/classrooms": ["libs/domain/src/classrooms/index.ts"],
      "@edunic/source/domain/custom-fields": ["libs/domain/src/custom-fields/index.ts"],
      "@edunic/source/domain/extensions": ["libs/domain/src/extensions/index.ts"],
      "@edunic/source/domain/feature-flags": ["libs/domain/src/feature-flags/index.ts"],
      "@edunic/source/domain/guardians": ["libs/domain/src/guardians/index.ts"],
      "@edunic/source/domain/institutions": ["libs/domain/src/institutions/index.ts"],
      "@edunic/source/domain/students": ["libs/domain/src/students/index.ts"],
      "@edunic/source/events": ["libs/events/src/index.ts"]
    }
  }
}
