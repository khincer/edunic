{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "apps/edunic-worker/**",
      "libs/**",
      "package.json",
      "package-lock.json",
      "nx.json",
      "tsconfig*.json",
      "railway.worker.json"
    ],
    "buildCommand": "npx nx build worker"
  },
  "deploy": {
    "startCommand": "node dist/apps/worker/main.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
